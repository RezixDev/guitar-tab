---
import "../styles/globals.css";
import type { Locale } from "@shared/types/i18n";
import Sidebar from "@shared/layout/Sidebar.astro";
import TopBar from "@shared/layout/TopBar.astro";
import { resolveLocale } from "@shared/i18n/getMessages";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = "Guitar Lab",
  description = "Master the guitar with interactive tools — chords, scales, fretboard, tuner, sheet music.",
  locale: localeProp,
} = Astro.props;

const locale = resolveLocale(localeProp ?? Astro.currentLocale);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var resolved =
            stored === "dark" || stored === "light"
              ? stored
              : prefersDark
                ? "dark"
                : "light";
          document.documentElement.classList.toggle(
            "dark",
            resolved === "dark",
          );
          document.documentElement.style.colorScheme = resolved;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <div class="flex min-h-screen">
      <Sidebar locale={locale} pathname={pathname} />
      <div class="flex min-w-0 flex-1 flex-col">
        <TopBar locale={locale} pathname={pathname} />
        <main class="flex-1">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
