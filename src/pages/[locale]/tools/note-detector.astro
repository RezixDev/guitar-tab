---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NoteDetectorApp from "@features/note-detector/NoteDetectorApp";
import { LOCALES, type Locale } from "@shared/types/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title="Live Note Detector — Guitar Lab">
  <NoteDetectorApp client:load />
</BaseLayout>
