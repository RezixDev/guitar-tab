---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ScalesApp from "@features/scales/ScalesApp";
import { LOCALES, type Locale } from "@shared/types/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title="Scales — Guitar Lab">
  <ScalesApp client:load />
</BaseLayout>
