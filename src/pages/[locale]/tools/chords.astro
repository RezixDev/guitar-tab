---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChordsApp from "@features/chords/ChordsApp";
import { LOCALES, type Locale } from "@shared/types/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title="Chords — Guitar Lab">
  <ChordsApp client:load />
</BaseLayout>
