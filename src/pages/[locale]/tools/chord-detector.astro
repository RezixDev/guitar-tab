---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChordDetectorApp from "@features/chord-detector/ChordDetectorApp";
import { LOCALES, type Locale } from "@shared/types/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout locale={locale} title="Live Chord Detector — Guitar Lab">
  <ChordDetectorApp client:load />
</BaseLayout>
