{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@messages/*": ["src/messages/*"]
    }
  },
  "include": ["src", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist", ".astro"]
}
